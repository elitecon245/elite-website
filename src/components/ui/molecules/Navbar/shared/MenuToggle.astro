---
import { getEliteCopy, type EliteLocale } from "@utils/elite-i18n";

interface Props {
	mobileOnly?: boolean;
	locale?: EliteLocale;
}

const { mobileOnly = true, locale = "pl" } = Astro.props;
const headerData = getEliteCopy(locale).navigation;
---

<button
	type="button"
	data-navbar-toggle
	class:list={["ui-nav-menu-toggle", mobileOnly && "lg:hidden"]}
	aria-controls="site-nav-drawer"
	aria-expanded="false"
	aria-label={headerData.aria.menuOpen}
>
	<span class="ui-nav-menu-toggle__bar" aria-hidden="true"></span>
	<span class="ui-nav-menu-toggle__bar" aria-hidden="true"></span>
	<span class="ui-nav-menu-toggle__bar" aria-hidden="true"></span>
</button>
