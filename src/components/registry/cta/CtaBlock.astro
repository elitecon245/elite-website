---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import jsonData from "@data/sections/nova-cta.json";
import { ACTIVE_TEMPLATE } from "@config/template";

type CtaLink = { label: string; href: string; srLabel?: string };
interface Props { links?: CtaLink[]; id?: string; locale?: "en" | "pl"; title?: string; description?: string; primaryLabel?: string; primaryHref?: string; secondaryLabel?: string; secondaryHref?: string; image?: string; imageAlt?: string; class?: string; }
const props = Astro.props as Props;
const fallback = ACTIVE_TEMPLATE === "nova" ? undefined : jsonData;
const title = props.title ?? fallback?.title;
const description = props.description ?? fallback?.description;
const primaryLabel = props.primaryLabel ?? fallback?.primaryLabel;
const primaryHref = props.primaryHref ?? fallback?.primaryHref;
const secondaryLabel = props.secondaryLabel ?? fallback?.secondaryLabel;
const secondaryHref = props.secondaryHref ?? fallback?.secondaryHref;
const image = props.image ?? fallback?.image;
const imageAlt = props.imageAlt ?? fallback?.imageAlt ?? "";
const links = props.links ?? [];
---

<Section id={props.id ?? (props.locale === "pl" ? "kontakt" : "contact")} tone="page" class:list={["cta-section", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="nova-cta-frame" style={`background-image: url('${image}')`}>
      <div class="nova-cta-copy">
        <Heading tag="h2" variant="section-title">{title}</Heading>
        <Text variant="lead">{description}</Text>
        {links.length > 0 && (
          <ul class="nova-cta-links">
            {links.map((link) => (
              <li>
                <i class="ph ph-map-pin" aria-hidden="true"></i>
                <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>{link.label}{link.srLabel && <span class="sr-only"> {link.srLabel}</span>}</a>
              </li>
            ))}
          </ul>
        )}
        <div class="nova-cta-actions">
          <Button href={primaryHref} variant="primary" size="lg">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="outline" size="lg">{secondaryLabel}</Button>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  :global(section.cta-section) { padding-top: 3rem; padding-bottom: 3rem; }
  .nova-cta-frame { position: relative; min-height: 24rem; display: flex; align-items: center; overflow: hidden; border-radius: var(--ui-radius-xl); background-color: var(--color-brand-dark); background-position: center; background-size: cover; }
  .nova-cta-frame::before { position: absolute; inset: 0; background: color-mix(in oklab, var(--color-brand-dark) 72%, transparent); content: ""; }
  .nova-cta-copy { position: relative; z-index: 1; display: flex; max-width: 42rem; flex-direction: column; gap: 1rem; padding: clamp(1.5rem, 6vw, 4rem); color: var(--color-brand-light); }
  .nova-cta-copy :global(.ui-heading), .nova-cta-copy :global(.ui-text) { color: inherit; }
  .nova-cta-copy :global(.ui-type-lead) { color: color-mix(in oklab, var(--color-brand-light) 85%, transparent); }
  .nova-cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .nova-cta-links { display: grid; gap: 0.5rem; margin: 0 0 0.5rem; padding: 0; list-style: none; }
  .nova-cta-links li { display: flex; align-items: baseline; gap: 0.5rem; }
  .nova-cta-links i { flex: none; color: var(--color-brand-accent); }
  .nova-cta-links a { color: var(--color-brand-light); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--color-brand-light) 45%, transparent); text-underline-offset: 0.25em; transition: color 180ms ease; }
  .nova-cta-links a:hover, .nova-cta-links a:focus-visible { color: var(--color-brand-accent); text-decoration-color: currentColor; }
  .nova-cta-actions :global(.ui-button-outline) { border-color: color-mix(in oklab, var(--color-brand-light) 65%, transparent); background: color-mix(in oklab, var(--color-brand-dark) 35%, transparent); color: var(--color-brand-light); }
</style>
