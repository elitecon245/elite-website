---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/elite-services.json";

type Service = { number: string; icon?: string; title: string; description: string };
interface Props { id?: string; locale?: "en" | "pl"; title?: string; description?: string; linkLabel?: string; linkHref?: string; items?: Service[]; class?: string; }
const props = Astro.props as Props;
const title = props.title ?? jsonData.title;
const description = props.description ?? jsonData.description;
const linkLabel = props.linkLabel ?? jsonData.linkLabel;
const linkHref = props.linkHref ?? jsonData.linkHref;
const items = props.items ?? jsonData.items;
---

<Section id={props.id ?? (props.locale === "pl" ? "uslugi" : "services")} tone="page" class:list={["services-section", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="elite-services-intro">
      <div>
        <Heading tag="h2" variant="section-title">{title}</Heading>
      </div>
      <div>
        <Text variant="lead">{description}</Text>
      </div>
      <div class="elite-services-link-wrap">
        <a class="group inline-flex items-center gap-2 transition-colors duration-300 hover:!text-brand-accent motion-reduce:transition-none" href={linkHref}>
          <span class="transition-transform duration-300 ease-out group-hover:-translate-x-1 motion-reduce:transition-none">{linkLabel}</span>
          <span class="inline-flex size-5 items-center justify-center leading-none transition-transform duration-300 ease-out group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="elite-services-grid">
      {items.map((item) => (
        <article class="elite-service-card ui-card-interactive group cursor-pointer transition-[background-color,border-color,box-shadow,transform] duration-300 ease-out hover:border-brand-accent hover:bg-brand-accent/10 motion-reduce:transition-none">
          <div class="elite-service-icon transition-[background-color,border-color,color] duration-300 group-hover:border-brand-accent group-hover:bg-brand-accent group-hover:text-brand-dark motion-reduce:transition-none" aria-hidden="true">
            <Icon name={item.icon ?? "sparkle"} />
          </div>
          <div class="elite-service-content">
            <div class="elite-service-title-line">
              <Text tag="span" variant="accent-label" class="elite-service-number transition-colors duration-300 group-hover:text-brand-dark/80 motion-reduce:transition-none">{item.number}</Text>
              <Heading tag="h3" variant="feature-title" class="elite-service-title">{item.title}</Heading>
            </div>
            <Text variant="body" class="elite-service-description transition-colors duration-300 group-hover:text-brand-dark/80 motion-reduce:transition-none">{item.description}</Text>
          </div>
          <span class="elite-service-arrow overflow-hidden transition-[background-color,border-color,color] duration-300 group-hover:border-brand-accent group-hover:bg-brand-accent group-hover:text-brand-light motion-reduce:transition-none" aria-hidden="true">
            <span class="relative flex size-4 items-center justify-center">
              <Icon name="arrow-up-right" class="absolute inset-0 size-4 transition-transform duration-300 ease-out group-hover:translate-x-[140%] group-hover:-translate-y-[140%] motion-reduce:transition-none" />
              <Icon name="arrow-up-right" class="absolute inset-0 size-4 -translate-x-[140%] translate-y-[140%] transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 motion-reduce:transition-none" />
            </span>
          </span>
        </article>
      ))}
    </div>
  </Container>
</Section>

<style>
  :global(section.services-section) {
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }

  .elite-services-intro {
    display: grid;
    gap: 1.5rem;
  }

  .elite-services-intro > div:last-child {
    display: flex;
    max-width: 32rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .elite-services-intro a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-brand-dark);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .elite-services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .elite-service-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.875rem;
    min-height: 4.5rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-lg);
    background: var(--color-surface);
    box-shadow: var(--ui-elevation-soft);
  }

  .elite-service-icon {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--color-brand-accent) 28%, transparent);
    border-radius: var(--ui-radius-full);
    background: transparent;
    color: var(--color-brand-accent);
    font-size: 1.125rem;
  }

  .elite-service-content {
    min-width: 0;
  }

  .elite-service-title-line {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.5rem;
  }

  .elite-service-number {
    flex: none;
    color: var(--ui-text-on-light-subtle);
    font-size: clamp(0.95rem, 1.2vw, 1.125rem) !important;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .elite-service-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: clamp(0.95rem, 1.2vw, 1.125rem) !important;
    line-height: 1.2;
  }

  .elite-service-description {
    display: block;
    margin-top: 0.625rem;
    color: var(--ui-text-on-light-subtle);
    font-size: clamp(0.8125rem, 0.35rem + 0.45vw, 0.9375rem);
    line-height: 1.45;
  }

  .elite-service-arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: none;
    place-items: center;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-full);
    color: var(--color-brand-dark);
    font-size: 0.9375rem;
  }

  @media (min-width: 48rem) {
    .elite-services-intro {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1.5rem;
    }

    .elite-services-intro > div:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
      max-width: 42rem;
    }

    .elite-services-link-wrap {
      align-self: end;
      justify-self: end;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .elite-services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .elite-service-card {
      min-height: 14rem;
    }
  }

  @media (min-width: 64rem) {
    .elite-services-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(0.75rem, 1.5vw, 1.5rem);
    }

    .elite-service-card {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      align-items: start;
      gap: 0.875rem;
      min-height: 0;
      padding: clamp(1rem, 1.6vw, 1.5rem);
    }

    .elite-service-icon {
      grid-column: 1;
      grid-row: 1;
      width: 3rem;
      height: 3rem;
      font-size: 1.35rem;
    }

    .elite-service-content {
      grid-column: 1 / -1;
      grid-row: 2;
      align-self: start;
    }

    .elite-service-title-line {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
    }

    .elite-service-number {
      display: inline;
    }

    .elite-service-title {
      display: block;
      overflow: visible;
      white-space: normal;
    }

    .elite-service-description {
      display: block;
    }

    .elite-service-arrow {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      align-self: center;
    }
  }

</style>
