---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import TestimonialsSection, { type Testimonial } from "@components/ui/testimonials-3";

interface Props {
  sectionId?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  /** Shown while the cards are sample placeholders, so they are never mistaken for real reviews. */
  placeholderNotice?: string;
  testimonials: Testimonial[];
  class?: string;
}
const props = Astro.props as Props;
const testimonials = props.testimonials ?? [];
// The cards are static, so they render as plain HTML; the island only hydrates when a photo
// is supplied, because the avatar swaps its initials for the image in the browser.
const hasImages = testimonials.some((testimonial) => testimonial.image);
---

{testimonials.length > 0 && (
<Section id={props.sectionId ?? "reviews"} tone="page" class:list={["py-16", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="mx-auto mb-16 flex max-w-xl flex-col items-center gap-3 text-center">
      {props.eyebrow && <p class="m-0 text-xs font-bold uppercase tracking-[0.14em] text-brand-primary">{props.eyebrow}</p>}
      {props.title && <Heading tag="h2" variant="section-title">{props.title}</Heading>}
      {props.description && <Text variant="lead">{props.description}</Text>}
      {props.placeholderNotice && (
        <p class="m-0 rounded-full border border-dashed border-brand-primary/50 bg-brand-primary/5 px-4 py-1.5 text-xs font-semibold text-brand-primary">{props.placeholderNotice}</p>
      )}
    </div>
    {hasImages ? <TestimonialsSection client:visible testimonials={testimonials} /> : <TestimonialsSection testimonials={testimonials} />}
  </Container>
</Section>
)}
